---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics', (e) => e.id.startsWith('zh-tw/'));
  return topics.map((t) => ({
    params: { slug: t.id.replace('zh-tw/', '') },
    props: { topic: t },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const base = import.meta.env.BASE_URL;
const slug = topic.id.replace('zh-tw/', '');
---

<Base
  title={topic.data.title}
  description={topic.data.description}
  lang="zh-tw"
  altHref={`${base}/en/topics/${slug}/`}
>
  <article>
    <h1>{topic.data.title}</h1>
    <p class="desc">{topic.data.description}</p>
    <span class="meta">最後證據查核日期：{topic.data.last_verified}（OpenEvidence）</span>
    <Content />
    {topic.data.references.length > 0 && (
      <div class="references">
        <strong>參考文獻</strong>
        <ol>
          {topic.data.references.map((r) => <li>{r}</li>)}
        </ol>
      </div>
    )}
  </article>
</Base>
