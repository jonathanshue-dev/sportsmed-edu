---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics', (e) => e.id.startsWith('en/'));
  return topics.map((t) => ({
    params: { slug: t.id.replace('en/', '') },
    props: { topic: t },
  }));
}

const { topic } = Astro.props;
const { Content } = await render(topic);
const base = import.meta.env.BASE_URL;
const slug = topic.id.replace('en/', '');
---

<Base
  title={topic.data.title}
  description={topic.data.description}
  lang="en"
  altHref={`${base}/topics/${slug}/`}
>
  <article>
    <h1>{topic.data.title}</h1>
    <p class="desc">{topic.data.description}</p>
    {topic.data.verification_pending ? (
      <span class="meta pending">Draft — evidence verification pending</span>
    ) : (
      <span class="meta">Evidence last verified: {topic.data.last_verified} (OpenEvidence)</span>
    )}
    <Content />
    {topic.data.references.length > 0 && (
      <div class="references">
        <strong>References</strong>
        <ol>
          {topic.data.references.map((r) => <li>{r}</li>)}
        </ol>
      </div>
    )}
  </article>
</Base>
